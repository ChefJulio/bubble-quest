package-as: BubbleQuest

# Companion addons in this repo ship beside BubbleQuest in the same zip, each its own folder in
# Interface\AddOns (the BigWigs/DBM model). tools/package.py's COMPANIONS must list the same.
# Questmarker: the stub that hands the old Questmarker settings to BubbleQuest; it also replaces the
# old Questmarker folder on update, so the old addon can't load beside the new one.
# BubbleMap lives here until the repo split but doesn't ship with BubbleQuest: it gets its own
# release and CurseForge project (docs/design/bubble-suite.md), so it's ignored below.
move-folders:
  BubbleQuest/Questmarker: Questmarker

# Release notes for CurseForge and GitHub: CHANGELOG.md holds only the coming release's notes;
# replace them before tagging (past notes stay on the release pages).
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Everything not shipped. tools/package.py --check (run by the release workflow) fails if this and
# package.py's list of shipped files ever disagree.
ignore:
  - .github
  - .vscode
  - .luarc.json
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - BubbleMap
  - CLAUDE.md
  - docs
  - tools
