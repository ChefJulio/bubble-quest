{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "workspace.library": [
    ".tools/vscode-wow-api/Annotations/Core",
    ".tools/wow-ui-source/Interface",
    ".tools/generated"
  ],
  "workspace.ignoreDir": [
    ".tools/lua-language-server-*",
    ".tools/research",
    ".tools/luals-log",
    ".tools/terrain",
    ".tools/vscode-wow-api/luasrc",
    ".tools/vscode-wow-api/wowdoc",
    ".release",
    "tools",
    "Libs"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.globals": [
    "BubbleQuestDB",
    "BubbleQuestCharDB",
    "QuestmarkerDB",
    "QuestmarkerCharDB",
    "LibForeverData",
    "SLASH_BUBBLEQUEST1",
    "SLASH_BUBBLEQUEST2",
    "SLASH_BUBBLEQUEST3",
    "SLASH_BUBBLEQUEST4",
    "SLASH_BUBBLEQUEST5",
    "BubbleQuest_OnAddonCompartmentClick",
    "BubbleQuest_OnAddonCompartmentEnter",
    "BubbleQuest_OnAddonCompartmentLeave",
    "BubbleQuestMinimapTooltip",
    "BubbleQuestAPI",
    "BubbleMapDB",
    "GetMinimapShape",
    "SLASH_BUBBLEMAP1",
    "SLASH_BUBBLEMAP2",
    "BubbleMap_ToggleMap",
    "BINDING_HEADER_BUBBLEMAP",
    "BINDING_NAME_BUBBLEMAP_TOGGLE_MAP"
  ],
  "diagnostics.disable": [],
  "diagnostics.severity": {
    "undefined-global": "Error",
    "undefined-field": "Error",
    "deprecated": "Error",
    "lowercase-global": "Error"
  }
}
